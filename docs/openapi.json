{
  "openapi": "3.1.0",
  "info": {
    "title": "Equipment Monitoring Service",
    "description": "Ingests machine data from multiple vendors, normalizes it, and serves a per-machine attention view plus plant/line summaries.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Health",
        "description": "Liveness check: the process is up and serving requests.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/v1/ingest/{vendor}": {
      "post": {
        "tags": [
          "ingestion"
        ],
        "summary": "Ingest",
        "description": "Accept a batch for background processing.\n\nOnly the envelope is checked here. Records are validated by the worker, and the\noutcome per record is available from the status URL.",
        "operationId": "ingest_v1_ingest__vendor__post",
        "parameters": [
          {
            "name": "vendor",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Vendor"
            }
          },
          {
            "name": "idempotency-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 128
                },
                {
                  "type": "null"
                }
              ],
              "description": "Retries with the same key return the original ingestion. If omitted, the SHA-256 of the canonical JSON body is used.",
              "title": "Idempotency-Key"
            },
            "description": "Retries with the same key return the original ingestion. If omitted, the SHA-256 of the canonical JSON body is used."
          },
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "description": "The vendor's batch, in its own format.",
                "title": "Payload"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestionAccepted"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid X-API-Key"
          },
          "409": {
            "description": "Idempotency-Key reused with a different payload"
          },
          "413": {
            "description": "Too many records in one batch"
          },
          "422": {
            "description": "Body is not a usable batch envelope"
          }
        }
      }
    },
    "/v1/ingestions/{ingestion_id}": {
      "get": {
        "tags": [
          "ingestion"
        ],
        "summary": "Get Ingestion",
        "description": "Processing status of an accepted batch: counts per outcome and its background job.",
        "operationId": "get_ingestion_v1_ingestions__ingestion_id__get",
        "parameters": [
          {
            "name": "ingestion_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Ingestion Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestionStatus"
                }
              }
            }
          },
          "404": {
            "description": "Unknown ingestion"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/ingestions/{ingestion_id}/records": {
      "get": {
        "tags": [
          "ingestion"
        ],
        "summary": "List Records",
        "description": "The batch's records with their outcome. `?status=rejected` lists what was refused and why.",
        "operationId": "list_records_v1_ingestions__ingestion_id__records_get",
        "parameters": [
          {
            "name": "ingestion_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Ingestion Id"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/RecordStatus"
                },
                {
                  "type": "null"
                }
              ],
              "description": "e.g. rejected",
              "title": "Status"
            },
            "description": "e.g. rejected"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1000,
              "minimum": 1,
              "default": 100,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RawRecordList"
                }
              }
            }
          },
          "404": {
            "description": "Unknown ingestion"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/machines": {
      "get": {
        "tags": [
          "machines"
        ],
        "summary": "List Machines",
        "description": "Attention view of every machine, most urgent first.",
        "operationId": "list_machines_v1_machines_get",
        "parameters": [
          {
            "name": "plant_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Plant Id"
            }
          },
          {
            "name": "line_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Line Id"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "NORMAL",
                    "WATCH",
                    "WARNING",
                    "CRITICAL",
                    "UNDER_MAINTENANCE",
                    "UNKNOWN"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "name": "needs_attention",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Needs Attention"
