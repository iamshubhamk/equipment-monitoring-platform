    "/v1/dead-letters/{job_id}/replay": {
      "post": {
        "tags": [
          "dead letters"
        ],
        "summary": "Replay Dead Letter",
        "description": "Re-queue a dead job with fresh attempts (after fixing whatever made it fail).\nRequires the operations X-API-Key.",
        "operationId": "replay_dead_letter_v1_dead_letters__job_id__replay_post",
        "parameters": [
          {
            "name": "job_id",
